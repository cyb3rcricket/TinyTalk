# TinyTalk provider. ollama is the default when this is unset.
TINYTALK_PROVIDER=ollama

# Fact-similarity and knowledge-graph debug lines. Off when unset.
# Save warnings and API errors are printed either way.
# TINYTALK_DEBUG=1

# Characters allowed in one outgoing chat request, including the soul file,
# retrieved memories, recent chat, and the new message. 2000 of that total
# is reserved for the reply. Unset uses 24000.
# TINYTALK_MAX_REQUEST_CHARS=24000

# Ollama. Used only when TINYTALK_PROVIDER=ollama.
# llama3.2:3b is the model TinyTalk already used.
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Grok. Used only when TINYTALK_PROVIDER=grok.
# Create a key at https://console.x.ai/team/default/api-keys
# Put the real key in .env, which is gitignored. Do not commit it.
XAI_API_KEY=
# Verified xAI API model ID (Grok 4.7). Not a Grok Build label or reasoning effort.
XAI_MODEL=grok-4.7

# Optional spoken output. VoiceStudio must already be running.
# TinyTalk does not send XAI_API_KEY, or any other key, to this server.
# VOICESTUDIO_BASE_URL=http://127.0.0.1:3900
# Saved profile id for TinyTalk — Curious Little Computer. Not the voice name "default".
# VOICESTUDIO_VOICE_ID=5e49413d
